{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["rule_id", "rule_type", "priority", "condition", "actions", "rationale", "classification", "evidence_status"],
    "properties": {
      "rule_id": {"type": "string", "minLength": 1},
      "rule_type": {"type": "string"},
      "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
      "condition": {"type": "object"},
      "actions": {"type": "array", "minItems": 1},
      "rationale": {"type": "string", "minLength": 1},
      "classification": {"enum": ["DIRECT_EVIDENCE", "INDIRECT_EVIDENCE", "CONSENSUS", "EXPERT_HEURISTIC", "DESIGN_DECISION", "SAFETY_PRECAUTION"]},
      "evidence_status": {"type": "string"}
    }
  }
}
