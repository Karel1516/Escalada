[
  {"rule_id": "CANDIDATE-SAFETY-FINGER-001", "rule_type": "SAFETY", "priority": 1000, "condition": {"field": "limitations.fingers", "operator": "IN", "value": ["limitacion", "lesion_rehabilitacion"]}, "actions": [{"action_type": "EXCLUDE_EXERCISE", "target": "FINGER_RESISTANCE"}, {"action_type": "BLOCK_PROGRESSION", "target": "finger_loading", "value": true}, {"action_type": "SHOW_WARNING", "target": "finger_warning", "value": "Carga específica de dedos bloqueada. No es un diagnóstico; consulta a un profesional sanitario cualificado."}], "rationale": "Precaución ante limitación declarada; la literatura no establece un umbral universal seguro.", "classification": "SAFETY_PRECAUTION", "evidence_status": "UNCERTAIN"},
  {"rule_id": "CANDIDATE-FINGER-ELIGIBILITY-001", "rule_type": "ELIGIBILITY", "priority": 100, "condition": {"combinator": "AND", "conditions": [{"field": "objective", "operator": "EQ", "value": "finger_strength"}, {"field": "equipment.hangboard", "operator": "EQ", "value": true}, {"field": "experience_years", "operator": "GTE", "value": 2}, {"field": "limitations.fingers", "operator": "EQ", "value": "ninguna"}]}, "actions": [{"action_type": "INCLUDE_EXERCISE", "target": "FINGER_RESISTANCE"}], "rationale": "La selección general tiene soporte indirecto para rendimiento; el umbral de experiencia es heurístico y debe revisarse.", "classification": "EXPERT_HEURISTIC", "evidence_status": "UNCERTAIN"},
  {"rule_id": "CANDIDATE-CLIMBING-001", "rule_type": "EXERCISE_SELECTION", "priority": 10, "condition": {"field": "equipment.wall", "operator": "EQ", "value": true}, "actions": [{"action_type": "INCLUDE_EXERCISE", "target": "CLIMBING_PRACTICE"}], "rationale": "Incluye práctica específica cuando existe muro; no fija dosis ni afirma superioridad de protocolo.", "classification": "CONSENSUS", "evidence_status": "LIMITED"},
  {"rule_id": "CANDIDATE-FINGER-ENDURANCE-001", "rule_type": "ELIGIBILITY", "priority": 90, "condition": {"combinator": "AND", "conditions": [{"field": "objective", "operator": "IN", "value": ["resistencia", "power_endurance"]}, {"field": "level", "operator": "IN", "value": ["avanzado", "elite"]}, {"field": "equipment.hangboard", "operator": "EQ", "value": true}, {"field": "limitations.fingers", "operator": "EQ", "value": "ninguna"}]}, "actions": [{"action_type": "INCLUDE_EXERCISE", "target": "FINGER_ENDURANCE"}], "rationale": "La intervención específica mejoró resistencia en una muestra avanzada; se limita a esa población y no adopta una dosis universal.", "classification": "DIRECT_EVIDENCE", "evidence_status": "LIMITED"},
  {"rule_id": "CANDIDATE-CAMPUS-ELIGIBILITY-001", "rule_type": "ELIGIBILITY", "priority": 80, "condition": {"combinator": "AND", "conditions": [{"field": "objective", "operator": "EQ", "value": "potencia"}, {"field": "level", "operator": "IN", "value": ["avanzado", "elite"]}, {"field": "equipment.campus_board", "operator": "EQ", "value": true}, {"field": "limitations.fingers", "operator": "EQ", "value": "ninguna"}, {"field": "limitations.elbow", "operator": "EQ", "value": "ninguna"}, {"field": "limitations.shoulder", "operator": "EQ", "value": "ninguna"}]}, "actions": [{"action_type": "INCLUDE_EXERCISE", "target": "CAMPUS_POWER"}], "rationale": "El ensayo disponible estudió únicamente escaladores avanzados/élite; la regla conserva esa frontera y no presupone seguridad ni dosis óptima.", "classification": "DIRECT_EVIDENCE", "evidence_status": "LIMITED"}
